{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "A native desktop cockpit for coding agents",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "postinstall": "node scripts/configure-node-pty.mjs",
    "dev": "node scripts/launch.mjs dev",
    "build": "npm run build:compile && npm start",
    "build:compile": "electron-vite build",
    "start": "node scripts/launch.mjs preview",
    "pack": "node scripts/install-app.mjs --pack-only",
    "install-app": "node scripts/install-app.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:platform": "vitest run scripts/launch.test.ts src/main/terminal.test.ts && node scripts/pty-smoke.mjs && node scripts/electron-pty-smoke.mjs && node scripts/electron-trust-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "generate-icons": "electron scripts/generate-icons.mjs",
    "client:drift": "node scripts/check-client-drift.mjs",
    "check": "npm run typecheck && npm test && npm run docs:check && npm run build:compile"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/client": "0.0.0-beta-19242",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "emmet-monaco-es": "^5.7.0",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "sass": "^1.102.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
